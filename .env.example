# z/OSMF Connection
ZOSMF_HOST=your-zosmf-host.internal
ZOSMF_PORT=443
# Optional — only set if your z/OSMF is behind an API gateway prefix (default: /zosmf)
# ZOSMF_BASE_PATH=/zosmf

# Authentication
ZOSMF_USER=your-username
ZOSMF_PASSWORD=your-password
# Or use token-based auth:
# ZOSMF_TOKEN=your-token
# ZOSMF_TOKEN_TYPE=LTPA2

# TLS
ZOSMF_REJECT_UNAUTHORIZED=true
# For internal CAs, set to false only in dev/test
# ZOSMF_REJECT_UNAUTHORIZED=false

# MCP Server
MCP_SERVER_NAME=mainframe-mcp-server
MCP_SERVER_VERSION=2.0.0
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=sse
# MCP_SSE_PORT=3000

# Logging
LOG_LEVEL=info
# LOG_LEVEL=debug for verbose Zowe SDK output

# Operational Limits (safety guards)
MAX_JOB_OUTPUT_LINES=5000
MAX_DATASET_READ_LINES=2000
MAX_JES_SPOOL_FILES=20
MAX_AUDIT_LINES=500

# Enterprise — CICS CMCI (optional)
# CMCI_CONTEXT=CICSPLEX1
# CMCI_HOST=your-cmci-host.internal
# CMCI_PORT=1490
# CMCI_BASE_PATH=/CICSSystemManagement

# Enterprise — Db2 REST (optional)
# DB2_LOCATION=LOC1
# DB2_HOST=your-db2-host.internal
# DB2_PORT=50400
# DB2_BASE_PATH=/dbrest

# Enterprise — SMF / RMF (optional)
# RMF_METRICS_ENABLED=true
# SMF_SUMMARY_DATASET=YOUR.SMF.SUMMARY

# Enterprise — RACF audit (optional)
# RACF_AUDIT_USS_PATH=/var/racf/audit.log
# RACF_AUDIT_DATASET=YOUR.RACF.AUDIT

# Enterprise security controls
# SECURITY_READ_ONLY=false
# SECURITY_AUDIT_LOGGING=true
# SECURITY_ALLOWED_TOOLS=list_jobs,get_job_status,get_job_output,analyze_job_failure,find_failed_jobs
# SECURITY_BLOCKED_TOOLS=submit_jcl
# SECURITY_ALLOWED_DATASET_PATTERNS=USERDEV.*,SYS1.*
# SECURITY_ALLOWED_USS_PATHS=/u/userdev,/tmp/app
# SECURITY_MAX_JCL_BYTES=65536

# Integration tests (optional — skipped unless RUN_INTEGRATION=1)
# RUN_INTEGRATION=1
# ZOSMF_DATASET_PATTERN=YOURUSER.*
# ZOSMF_USS_PATH=/u/youruser
